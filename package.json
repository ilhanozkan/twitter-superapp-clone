    "check:sanity-privacy": "tsx scripts/check-sanity-privacy.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@sanity/client": "^8.9.0",
    "next": "16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
