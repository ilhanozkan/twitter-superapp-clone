# Copy to .env.local and fill in. Every variable is optional: with nothing set
# the app runs on the bundled in-memory demo data (resets on restart).

# Where data lives: "memory" or "sanity". Unset = Sanity when SANITY_PROJECT_ID
# is set, otherwise the in-memory demo store.
# DATA_SOURCE=memory

# Sanity project (https://www.sanity.io/manage). The old NEXT_PUBLIC_SANITY_*
# names are still read, but the app no longer needs them in the browser.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Editor token for writes. Server-side only: never prefix it with NEXT_PUBLIC_.
# Without a token the Sanity data source is read-only.
SANITY_API_TOKEN=

# The account every request acts as (there is no sign-in yet).
# DEMO_USERNAME=illlhanozkan

# Writes (POST/PUT/DELETE) allowed per client per minute; 0 disables the limit.
# WRITE_RATE_LIMIT=30

# Reject every write with 403. There is no sign-in, so with a Sanity write
# token every visitor acts as DEMO_USERNAME: enable this for public demos.
# READ_ONLY=true

# Trust X-Real-IP / X-Forwarded-For for rate limiting. Only enable behind a
# proxy that sets them (automatic on Vercel); otherwise clients can spoof them.
# TRUST_PROXY=true
