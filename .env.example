# Copy to .env.local and fill in. Every variable is optional: with nothing set
# the app runs on the bundled in-memory demo data (resets on restart).

# Where data lives: "memory" or "sanity". Unset = Sanity when SANITY_PROJECT_ID
# is set, otherwise the in-memory demo store.
# DATA_SOURCE=memory

# Sanity project (https://www.sanity.io/manage). The old NEXT_PUBLIC_SANITY_*
# names are still read, but the app no longer needs them in the browser.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Editor token for writes. Server-side only: never prefix it with NEXT_PUBLIC_.
# Without a token the Sanity data source is read-only, and the private
# SuperApp features (wallet, messages, channels, orders, rides) are
# unavailable (hidden, and their API answers 503): their documents use
# "private." ids, which Sanity only returns to requests with a token, even
# from a public dataset. With a private dataset
# the app needs the token for every read. Either way, run
# `npm run check:sanity-privacy` to prove that nothing private is readable
# without a token (docs/SUPERAPP.md#privacy).
SANITY_API_TOKEN=

# The account every request acts as (there is no sign-in yet).
# DEMO_USERNAME=illlhanozkan

# Writes (POST/PUT/DELETE) allowed per client per minute; 0 disables the limit.
# WRITE_RATE_LIMIT=30

# Reject every write with 403. There is no sign-in, so with a Sanity write
# token every visitor acts as DEMO_USERNAME: enable this for public demos.
# READ_ONLY=true

# Speeds up demo orders and rides: an integer from 1 (real time, the default)
# to 600. Only new orders and rides use it; minimum real-time windows (15 s to
# cancel an order, 30 s to cancel a ride for free) never shrink. The e2e suite
# uses 60.
# SUPERAPP_TIME_SCALE=1

# Kill switch: SuperApp features to turn off, separated by commas or spaces
# (wallet, messages, channels, shop, orders, rides, stories). Their pages and
# API routes answer 404 and their navigation is hidden. An unknown name is a
# configuration error (pages and API calls fail until it is fixed), so a typo
# can't leave a feature on.
# DISABLED_FEATURES=rides,stories

# Behind a reverse proxy, identify clients for rate limiting by the right-most
# X-Forwarded-For entry (the address your proxy saw). Only enable when a proxy
# appends it; otherwise clients can spoof it. Vercel is detected automatically.
# Flags accept true/1/yes/on.
# TRUST_PROXY=true

# Public URL of the deployment, used for absolute link-preview (Open Graph) URLs.
# NEXT_PUBLIC_SITE_URL=https://twitter-superapp.example.com
